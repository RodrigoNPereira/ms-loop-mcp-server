{
  "name": "ms-loop-mcp-server",
  "version": "0.2.0",
  "description": "Unofficial local stdio MCP server for discovering, reading, creating, and updating Microsoft Loop pages.",
  "keywords": [
    "mcp",
    "loop",
    "microsoft",
    "microsoft-loop",
    "model-context-protocol"
  ],
  "author": "Vilson Rodrigues <23613942+vilsonrodrigues@users.noreply.github.com>",
  "contributors": [
    "Shayan Khaksar <sh.khaksar95@gmail.com>"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ms-loop-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.52.0",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vilsonrodrigues/ms-loop-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/vilsonrodrigues/ms-loop-mcp-server/issues"
  },
  "homepage": "https://github.com/vilsonrodrigues/ms-loop-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  }
